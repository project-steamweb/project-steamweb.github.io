# 服务端口（默认 8787）
PORT=8787
# 监听地址（默认仅本机；如需局域网访问可改为 0.0.0.0）
HOST=127.0.0.1

# 可选：覆盖内置的加密 Key（一般不需要）
# 项目默认从 .steam-key.enc 读取加密后的 Steam Web API Key。
# 如需更换 Key，请运行：node set-key.mjs <32位Key>
# 仅在临时调试时才设置下面的变量，生产使用请留空。
STEAM_API_KEY=

# 可选：对外访问地址（部署在反向代理 / 隧道后面时需要）
# TLS 在远端终止时，本机服务收到的是普通 HTTP，Steam 又只接受 https 的回跳地址，
# 用这个变量明确告诉服务端对外协议，登录回调地址才会是 https://。
# 也可以让反向代理转发 X-Forwarded-Host / X-Forwarded-Proto，效果相同。
PUBLIC_ORIGIN=https://steam.wangzic.fun

# 可选：管理员账号密码（不设置则用 steamweb / qwerQWER1）
# ADMIN_USERNAME=steamweb
# ADMIN_PASSWORD=你的强密码

# 可选：Steam OpenID 登录时声明的身份地址。默认用 OpenID 2.0 的通用身份
# http://specs.openid.net/auth/2.0/identifier_select（SteamDB / ProtonDB 等都这么发，
# Steam 收到后会弹账号选择并回传真实身份）。改这个文件后**不用重启服务**。
# STEAM_OPENID_CLAIMED_ID=http://specs.openid.net/auth/2.0/identifier_select

# 可选：是否带 openid.realm（默认带本站地址，SteamDB 之外的站点都带）。
# STEAM_OPENID_REALM=off

# 可选：只发其中一个身份字段（默认 both）。
# STEAM_OPENID_IDENTITY_MODE=both
